  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_INTRO",
    "dynamic_line": "So, what's up?",
    "responses": [
      { "text": "Who are you?", "topic": "TALK_NPC_CABIN_CHEMIST_STORY" },
      { "text": "What is this place?", "topic": "TALK_NPC_CABIN_CHEMIST_HOME" },
      { "text": "Care to trade?", "topic": "TALK_NPC_CABIN_CHEMIST_INTRO", "effect": "start_trade" },
      {
        "text": "Any jobs you need done?",
        "condition": { "and": [ { "not": "has_assigned_mission" }, { "not": "has_many_assigned_missions" } ] },
        "topic": "TALK_MISSION_LIST"
      },
      {
        "text": "Can we talk about the mutation research?",
        "condition": { "u_has_var": "cabin_chemist_research_read", "value": "yes" },
        "topic": "TALK_NPC_CABIN_CHEMIST_RESEARCH"
      },
      { "text": "I gotta go.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_STORY",
    "dynamic_line": "I used to be a chemist.  Well, I am a chemist.  I brought some equipment when I fled the city, but I had to leave the more sensitive instruments behind.  I found a few useful things in the cupboards here, so I moved in.",
    "responses": [ { "text": "I see.", "topic": "TALK_NONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_HOME",
    "dynamic_line": "Not my place, just somewhere I ended up.  Maybe a hunting cabin, or something less respectable, judging by what was on the shelves.  It was quiet and far enough from the <zombies>, so I stayed.",
    "responses": [ { "text": "Makes sense.", "topic": "TALK_NONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_RESEARCH",
    "dynamic_line": "Mutagens can change your body permanently.  Ordinary mutagen can lead to changes from different lines of research.  A targeted serum is injected and pushes you toward one line, but it doesn't let you choose the exact changes.",
    "responses": [
      { "text": "Can I undo a mutation?", "topic": "TALK_NPC_CABIN_CHEMIST_PURIFIER" },
      { "text": "Could I make these myself?", "topic": "TALK_NPC_CABIN_CHEMIST_EQUIPMENT" },
      { "text": "Let's talk about something else.", "topic": "TALK_NONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_PURIFIER",
    "dynamic_line": "Purifier can remove some mutations, including ones you'd rather keep.  It won't reliably get rid of the one you want gone.  Some changes can't be undone at all.",
    "responses": [ { "text": "What else did you learn?", "topic": "TALK_NONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_CABIN_CHEMIST_EQUIPMENT",
    "dynamic_line": "You'd need the right recipe, chemistry skills, specialized equipment, and ingredients.  Old labs are your best bet for the research.  Don't assume a cabin lab like mine can make what's in those records.",
    "responses": [ { "text": "What else did you learn?", "topic": "TALK_NONE" } ]
  }
]
