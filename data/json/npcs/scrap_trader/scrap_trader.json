  {
    "type": "talk_topic",
    "id": [ "TALK_NPC_SCRAP_TRADER", "TALK_NPC_SCRAP_TRADER_INTRO" ],
    "dynamic_line": {
      "npc_has_var": "scrap_trader_railgun_repaired",
      "value": "yes",
      "yes": "Never thought I'd get that rifle working.  Glad you came along.  Looking for salvage today?",
      "no": "Haven't had much company out here.  Looking for tools, parts, or just a bit of scrap?"
    },
    "speaker_effect": { "condition": { "npc_has_class": "NC_SCAVENGER" }, "effect": { "npc_change_class": "NC_SCRAP_TRADER" } },
    "responses": [
      { "text": "Let me see what you've got.", "effect": "start_trade", "topic": "TALK_NPC_SCRAP_TRADER" },
      { "text": "What's your story?", "topic": "TALK_NPC_SCRAP_TRADER_STORY" },
      { "text": "Why stay here of all places?", "topic": "TALK_NPC_SCRAP_TRADER_FORT" },
      {
        "text": "Found anything out of the ordinary?",
        "condition": { "not": "has_no_available_mission" },
        "topic": "TALK_MISSION_LIST"
      },
      { "text": "About that job…", "condition": "has_assigned_mission", "topic": "TALK_MISSION_INQUIRE" },
      { "text": "See you around.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_SCRAP_TRADER_STORY",
    "dynamic_line": "I used to work the yard.  I was on a solo shift when <the_cataclysm> hit, so I stayed put.  These days I pull anything useful out of the junk and sell it to whoever comes through.",
    "responses": [ { "text": "Makes sense.", "topic": "TALK_NONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_SCRAP_TRADER_FORT",
    "dynamic_line": "Like I said, I was already here when the dead got pissed off.  This place had barbed wire, tools, and enough scrap to put up those walls myself.",
    "responses": [
      { "text": "Interesting.", "topic": "TALK_NONE" },
      { "text": "Think I could stay here?", "topic": "TALK_NPC_SCRAP_TRADER_HOME_STAY" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_NPC_SCRAP_TRADER_HOME_STAY",
    "dynamic_line": "Sure, I'm fine with it.  There's a spare bed over there for anyone who needs it.  Just don't hog it.",
    "responses": [ { "text": "Thanks.", "topic": "TALK_NPC_SCRAP_TRADER" } ]
  }
]
