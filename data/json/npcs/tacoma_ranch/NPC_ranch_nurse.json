  {
    "type": "talk_topic",
    "id": "TALK_RANCH_NURSE_JOB",
    "dynamic_line": "I look after the clinic's patients and keep the dispensary stocked with basic medical supplies.",
    "responses": [ { "text": "OK.", "topic": "TALK_RANCH_NURSE" } ]
  },
  {
    "id": "TALK_RANCH_NURSE_AID",
    "type": "talk_topic",
    "dynamic_line": {
      "npc_service": true,
      "yes": "I can take a look at you or your companions if you are injured.  Supplies are in shortage, so unfortunately I'll have to ask you for 200 Merch, or 80 if it's just you.",
      "no": "Come back later, I need to take care of a few things first."
    },
    "responses": [
      {
        "text": "[80 Merch, 30m] I need you to patch me up.",
        "topic": "TALK_RANCH_NURSE_AID_DONE",
        "condition": { "u_has_items": { "item": "FMCNote", "count": 80 } },
        "effect": [ { "u_sell_item": "FMCNote", "count": 80 }, "give_aid" ]
      },
      {
        "text": "[200 Merch, 1h] I need you to patch up me and my companions.",
        "topic": "TALK_RANCH_NURSE_AID_DONE",
        "condition": { "u_has_items": { "item": "FMCNote", "count": 200 } },
        "effect": [ { "u_sell_item": "FMCNote", "count": 200 }, "give_all_aid" ]
      },
      { "text": "On second thought, I should be fine.", "topic": "TALK_RANCH_NURSE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_RANCH_NURSE_AID_DONE",
    "dynamic_line": "Hold still then.  It's the best I can do on short notice.",
    "responses": [ { "text": "…", "topic": "TALK_DONE" } ]
  },
  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_EXPAND_CLINIC",
    "name": "Expand Medical Care",
    "description": "Bring the Tacoma nurse three hotplates for the new ward. Payment: <reward_count:FMCNote> Merch.",
    "goal": "MGOAL_FIND_ITEM",
    "difficulty": 5,
    "value": 1250,
    "item": "hotplate",
    "count": 3,
    "origins": [ "ORIGIN_SECONDARY" ],
    "followup": "MISSION_TACOMA_RECRUIT_PHYSICIAN",
    "dialogue": {
      "describe": "We need more room for patients.",
      "offer": "The crew can build a ward and furnish it, but I need three hotplates to sterilize equipment and prepare supplies. I'll pay you 5 Merch. The dispensary will carry more supplies after its next restock.",
      "accepted": "I'll get the beds ready.",
      "rejected": "Let me know if you change your mind.",
      "advice": "Try kitchens, break rooms, and laboratories. They don't need batteries.",
      "inquire": "Did you bring the hotplates?",
      "success": "The new ward is ready for patients. I'll have more wound-care supplies and kits at the next restock.",
      "success_lie": "I still need all three hotplates.",
      "failure": "The ward will have to wait."
    },
    "end": {
      "effect": [ { "u_buy_item": "FMCNote", "count": 5 }, { "npc_change_class": "NC_TACOMA_CLINIC_NURSE_EXPANDED" } ],
      "update_mapgen": [
        { "om_terrain": "ranch_camp_50", "mapgen_update_id": "tacoma_expand_clinic" },
        {
          "om_terrain": "ranch_camp_50_z1",
          "place_nested": [ { "chunks": [ "tacoma_commune_clinic_roof_2" ], "x": 0, "y": 0 } ]
        }
      ]
    }
  },
  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_RECRUIT_PHYSICIAN",
    "name": "Recruit a Physician",
    "description": "Bring an anesthesia kit to the Tacoma nurse so the physician can join the clinic. Payment: <reward_count:FMCNote> Merch.",
    "goal": "MGOAL_CONDITION",
    "goal_condition": { "u_has_item": "anesthetic_kit" },
    "difficulty": 5,
    "value": 6000,
    "origins": [ "ORIGIN_SECONDARY" ],
    "dialogue": {
      "describe": "We have room for a physician now.",
      "offer": "A physician is willing to come here, but we need an anesthesia kit to equip the clinic for implant surgery. Bring one and I'll pay you 24 Merch.",
      "accepted": "I'll tell the physician we're getting the surgical supplies together.",
      "rejected": "Let me know if you change your mind.",
      "advice": "Check doctors' offices or medical labs. You can also make the kit with enough first aid knowledge.",
      "inquire": "Did you find an anesthesia kit?",
      "success": "The physician is here. Ask them about installing or removing implants.",
      "success_lie": "I still need the kit.",
      "failure": "We can't bring the physician in yet."
    },
    "end": {
      "effect": [ { "u_sell_item": "anesthetic_kit" }, { "u_buy_item": "FMCNote", "count": 24 } ],
      "update_mapgen": [ { "om_terrain": "ranch_camp_50", "mapgen_update_id": "tacoma_recruit_physician" } ]
    }
  }
