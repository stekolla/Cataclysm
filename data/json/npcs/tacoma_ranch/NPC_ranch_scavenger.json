  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_EQUIP_SCAVENGERS",
    "name": "Equip the Scavenging Teams",
    "description": "Deliver five wearable flashlights to Tacoma's Scavenger Boss to improve the depot's stock. Payment: <reward_count:FMCNote> Merch.",
