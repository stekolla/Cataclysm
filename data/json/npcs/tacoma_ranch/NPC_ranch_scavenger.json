    "count": 5,
    "origins": [ "ORIGIN_SECONDARY" ],
    "dialogue": {
      "describe": "Our recruits need hands-free lights.",
      "offer": "It's hard to search a dark building with one hand holding a light.  Bring me five wearable flashlights for the recruits.  I'll pay 3 Merch, and we ought to have more to sell after the next run.",
      "accepted": "The teams will put them to good use.",
      "rejected": "No problem.  We're still open for trade.",
      "advice": "You can make them yourself if you can't find enough.",
      "inquire": "Have you found all five lights?",
      "success": "That equips the new team.  Check back after we restock for a wider selection.",
      "success_lie": "I still need five wearable flashlights.",
      "failure": "The recruits will have to share lights for now."
    },
