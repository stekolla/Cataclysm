  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_IMPROVE_FIELDS",
    "name": "Improve the Fields",
    "description": "Bring Tacoma's Crop Overseer 30 units of liquid fertilizer for <reward_count:FMCNote> Merch and better stock at the shop's next restock.",
    "goal": "MGOAL_FIND_ITEM",
    "difficulty": 5,
    "value": 1250,
    "item": "fertilizer_liquid",
    "count": 30,
    "origins": [ "ORIGIN_SECONDARY" ],
    "followup": "MISSION_TACOMA_BUILD_GREENHOUSE",
    "dialogue": {
      "describe": "We could use fertilizer for the new plot.",
      "offer": "Bring me 30 units of liquid fertilizer and I'll pay you 5 Merch.  I'll have more seed and supplies for sale after the next restock.",
      "accepted": "I'll have the crew ready to work the new rows.",
      "rejected": "Let me know if you change your mind.",
      "advice": "Try farm supply sheds, or make it from commercial fertilizer or bone meal.",
      "inquire": "Have you brought the liquid fertilizer?",
      "success": "The extra rows are ready and another farmer is here to work them.  I'll have more seed and supplies at the next restock.",
      "success_lie": "I still need the fertilizer.",
      "failure": "The new rows will have to wait."
    },
    "end": {
      "effect": [ { "u_buy_item": "FMCNote", "count": 5 }, { "npc_change_class": "NC_TACOMA_CROP_MERCHANT_EXPANDED" } ],
      "update_mapgen": [
        { "om_terrain": "ranch_camp_65", "mapgen_update_id": "tacoma_expand_fields" },
        { "om_terrain": "ranch_camp_66", "place_npcs": [ { "class": "ranch_farmer_2", "x": 9, "y": 22 } ] }
      ]
    }
  },
  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_BUILD_GREENHOUSE",
    "name": "Build the Greenhouse",
    "description": "Deliver 30 glass sheets to Tacoma's Crop Overseer to build the greenhouse. Payment: <reward_count:FMCNote> Merch.",
    "goal": "MGOAL_FIND_ITEM",
    "difficulty": 5,
    "value": 4000,
    "item": "glass_sheet",
    "count": 30,
    "origins": [ "ORIGIN_SECONDARY" ],
    "dialogue": {
      "describe": "We need glass for a greenhouse.",
      "offer": "The fields are doing well, but the weather limits what we can grow.  We can build the frame and make the planting beds.  Bring me 30 glass sheets and I'll pay 16 Merch.",
      "accepted": "We'll get the planting beds ready.",
      "rejected": "Let me know if you change your mind.",
      "advice": "Try salvaging intact windows.  The sheets are bulky, so you might want a vehicle.",
      "inquire": "Have you found all 30 sheets?",
      "success": "The greenhouse is ready.  We can protect more delicate plants now.  I'll have a wider variety of seed and produce at the next restock.",
      "success_lie": "I still need 30 glass sheets.",
      "failure": "We'll stick to the open fields for now."
    },
    "end": {
      "effect": [ { "u_buy_item": "FMCNote", "count": 16 }, { "npc_change_class": "NC_TACOMA_CROP_MERCHANT_GREENHOUSE" } ],
      "update_mapgen": [
        { "om_terrain": "ranch_camp_52", "mapgen_update_id": "tacoma_build_greenhouse" },
        {
          "om_terrain": "ranch_camp_52_z1",
          "place_nested": [ { "chunks": [ "tacoma_commune_greenhouse_roof_1" ], "x": 0, "y": 0 } ]
        }
      ]
    }
  },
  {
    "type": "talk_topic",
    "id": "TALK_RANCH_CROP_OVERSEER_JOB",
    "dynamic_line": {
      "npc_has_class": "NC_TACOMA_CROP_MERCHANT_GREENHOUSE",
      "yes": "I look after the fields and the greenhouse.  Under glass we can keep more delicate crops sheltered and offer a wider choice of seed and produce.",
      "no": "I manage the fields and make sure Tacoma has enough seed and food.  I also sell seed, tools, and whatever we can spare."
    },
    "responses": [ { "text": "Good to know.", "topic": "TALK_RANCH_CROP_OVERSEER" } ]
