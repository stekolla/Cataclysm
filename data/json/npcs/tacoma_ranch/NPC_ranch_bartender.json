  {
    "type": "talk_topic",
    "id": "TALK_RANCH_BARKEEP_JOB",
    "dynamic_line": {
      "npc_has_class": "NC_TACOMA_BARTENDER_EXPANDED",
      "yes": "I run the bar.  With the extra vats and storage, I can keep more than one batch going.  The good bottles the scavengers bring in are still for special occasions.",
      "no": "If it isn't obvious, I oversee the bar here.  The scavengers bring in old world alcohol that we sell for special occasions.  For most that come through here though, the drinks we brew ourselves are the only thing they can afford."
    },
    "responses": [ { "text": "I see.", "topic": "TALK_RANCH_BARKEEP" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_RANCH_BARKEEP_INFORMATION",
    "dynamic_line": "We have a policy of keeping information to ourselves.  Ask the patrons if you want to hear rumors or news.",
    "responses": [ { "text": "Thanks for nothing.", "topic": "TALK_RANCH_BARKEEP" } ]
  },
  {
    "type": "mission_definition",
    "id": "MISSION_TACOMA_EXPAND_BREWERY",
    "name": "Expand the Brewery",
    "description": "Deliver 20 units of yeast to Tacoma's bartender to expand the brewery. Payment: <reward_count:FMCNote> Merch.",
    "goal": "MGOAL_FIND_ITEM",
    "difficulty": 3,
    "value": 1500,
    "item": "yeast",
    "count": 20,
    "origins": [ "ORIGIN_SECONDARY" ],
    "dialogue": {
      "describe": "I need fresh yeast for the brewery.",
      "offer": "The crew can add a brewing room and some storage, but I need fresh yeast before I can fill the new vats.  Bring me 20 units and I'll pay 6 Merch.",
      "accepted": "I'll get the vats ready.",
      "rejected": "No problem.  The bar's still open.",
      "advice": "Try bakeries or kitchen cupboards.",
      "inquire": "Did you find enough yeast?",
      "success": "The extension is ready.  Check back after we restock if you want to try something new.",
      "success_lie": "I still need 20 units of yeast.",
      "failure": "I'll stick to smaller batches for now."
    },
