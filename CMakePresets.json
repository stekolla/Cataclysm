{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "wasm-tiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "displayName": "WebAssembly Game",
      "description": "Build Bright Nights for desktop browsers with Emscripten.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "TILES": "ON",
        "CURSES": "OFF",
        "SOUND": "OFF",
        "BACKTRACE": "OFF",
        "DYNAMIC_LINKING": "OFF",
        "BUILD_SDL3": "ON",
        "USE_PREFIX_DATA_DIR": "OFF",
        "USE_HOME_DIR": "OFF",
        "TESTS": "OFF",
        "LUA_DOCS_ON_BUILD": "OFF"
      }
    },
    {
      "name": "wasm-tests",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "displayName": "WebAssembly Tests",
      "description": "Build the browser game and Catch2 runner for headless-browser tests.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "TILES": "ON",
        "CURSES": "OFF",
        "SOUND": "OFF",
        "BACKTRACE": "OFF",
        "DYNAMIC_LINKING": "OFF",
        "BUILD_SDL3": "ON",
        "USE_PREFIX_DATA_DIR": "OFF",
        "USE_HOME_DIR": "OFF",
        "TESTS": "ON",
        "LUA_DOCS_ON_BUILD": "OFF",
        "CATA_FORMAT_TARGETS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-tests",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "displayName": "Linux Test Runner",
      "description": "Build and run non-graphical Catch2 tests on Linux without a game executable.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TILES": "OFF",
        "CURSES": "ON",
        "SOUND": "OFF",
        "CATA_SDL": "OFF",
        "CATA_TESTS_ONLY": "ON",
        "TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "USE_PREFIX_DATA_DIR": "OFF",
        "USE_HOME_DIR": "OFF",
        "LUA_DOCS_ON_BUILD": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "wasm-tiles", "configurePreset": "wasm-tiles", "targets": ["cataclysm-bn-tiles"] },
    { "name": "wasm-tests", "configurePreset": "wasm-tests", "targets": ["cataclysm-bn-tiles", "cata_test-tiles"] },
    { "name": "linux-tests", "configurePreset": "linux-tests", "targets": ["cata_test"] }
  ]
}
